{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cropsage.local/schemas/crop-catalog-1.1.0.json",
  "title": "CropSage Texas crop catalog",
  "description": "Catalog contract version 1.1.0. Every crop property is structurally required for a stable consumer contract. A property whose schema permits null contains optional numeric evidence: null means not numerically established, never zero, favorable evidence, compatibility, or safety.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog_version",
    "jurisdiction",
    "last_reviewed",
    "record_status_definition",
    "scoring_policy",
    "regions",
    "references",
    "crops"
  ],
  "properties": {
    "catalog_version": { "type": "string", "const": "1.1.0" },
    "jurisdiction": { "type": "string", "const": "Texas, United States" },
    "last_reviewed": { "type": "string", "format": "date" },
    "record_status_definition": { "type": "object" },
    "scoring_policy": {
      "type": "object",
      "description": "Catalog-wide evidence interpretation rules. Runtime scoring must honor evidence_status and field-level scoring_use and must not reward missing optional evidence."
    },
    "regions": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/region" }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reference" }
    },
    "crops": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": { "$ref": "#/$defs/crop" }
    }
  },
  "$defs": {
    "sourceId": { "type": "string", "pattern": "^SRC-[0-9]{3}$" },
    "regionId": {
      "type": "string",
      "enum": [
        "plains",
        "eastern",
        "central_south_winter_garden",
        "lower_rio_grande_valley",
        "far_west"
      ]
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "name", "description", "source_ids"],
      "properties": {
        "region_id": { "$ref": "#/$defs/regionId" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceId" }
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "title", "publisher", "source_type", "url", "supports", "accessed_on"],
      "properties": {
        "source_id": { "$ref": "#/$defs/sourceId" },
        "title": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "source_type": { "type": "string", "enum": ["government", "extension", "international_guidance"] },
        "url": { "type": "string", "format": "uri" },
        "supports": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "accessed_on": { "type": "string", "format": "date" }
      }
    },
    "evidenceStatus": {
      "type": "string",
      "description": "Strength and transferability of the supporting evidence. not_numerically_established requires non-numeric, informational treatment.",
      "enum": ["direct", "regional_transfer", "generalized", "not_numerically_established"]
    },
    "temperatureRange": {
      "type": "object",
      "description": "Core numeric evidence used for comparable MVP temperature-fit assessment across all catalog crops.",
      "additionalProperties": false,
      "required": ["min_c", "max_c", "basis", "evidence_status", "source_ids"],
      "properties": {
        "min_c": { "type": "number" },
        "max_c": { "type": "number" },
        "basis": { "type": "string", "minLength": 1 },
        "evidence_status": { "$ref": "#/$defs/evidenceStatus" },
        "source_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceId" } }
      }
    },
    "heatThreshold": {
      "type": "object",
      "description": "Supplementary crop heat-risk evidence. The object is structurally required, but value_c and operator are optional numeric evidence and may be null when no transferable threshold is established.",
      "additionalProperties": false,
      "required": ["value_c", "operator", "basis", "severity", "scoring_use", "evidence_status", "source_ids"],
      "properties": {
        "value_c": {
          "type": ["number", "null"],
          "description": "Optional Celsius threshold. Null means no transferable numeric threshold was established and must not be imputed from the optimal range."
        },
        "operator": {
          "type": ["string", "null"],
          "enum": [">", ">=", null],
          "description": "Comparison operator for value_c. Must be null when value_c is null."
        },
        "basis": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["warning", "not_established"] },
        "scoring_use": {
          "type": "string",
          "enum": ["soft_penalty", "informational_only"],
          "description": "Catalog evidence capability. The MVP calculation policy may conservatively restrict numeric thresholds to risk or explanation even when soft_penalty is recorded."
        },
        "evidence_status": { "$ref": "#/$defs/evidenceStatus" },
        "source_ids": { "type": "array", "items": { "$ref": "#/$defs/sourceId" } }
      },
      "allOf": [
        {
          "if": {
            "properties": { "value_c": { "type": "null" } },
            "required": ["value_c"]
          },
          "then": {
            "properties": {
              "operator": { "type": "null" },
              "severity": { "const": "not_established" },
              "scoring_use": { "const": "informational_only" },
              "evidence_status": { "const": "not_numerically_established" }
            }
          }
        },
        {
          "if": {
            "properties": { "value_c": { "type": "number" } },
            "required": ["value_c"]
          },
          "then": {
            "properties": {
              "operator": { "type": "string", "enum": [">", ">="] },
              "severity": { "const": "warning" }
            }
          }
        }
      ]
    },
    "heatDuration": {
      "type": "object",
      "description": "Supplementary duration evidence. The object and nullable properties are structurally required, but null duration values are valid and remain informational when no transferable biological duration was established.",
      "additionalProperties": false,
      "required": ["hours", "consecutive_days", "description", "scoring_use", "evidence_status", "source_ids"],
      "properties": {
        "hours": {
          "type": ["number", "null"],
          "description": "Optional sourced exposure duration in hours. Null must not be converted to zero or inferred from provider observations."
        },
        "consecutive_days": {
          "type": ["integer", "null"],
          "description": "Optional sourced consecutive-day duration. Null must not be converted to zero or inferred from provider observations."
        },
        "description": { "type": "string", "minLength": 1 },
        "scoring_use": { "type": "string", "enum": ["soft_penalty", "informational_only"] },
        "evidence_status": { "$ref": "#/$defs/evidenceStatus" },
        "source_ids": { "type": "array", "items": { "$ref": "#/$defs/sourceId" } }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "hours": { "type": "null" },
              "consecutive_days": { "type": "null" }
            },
            "required": ["hours", "consecutive_days"]
          },
          "then": {
            "properties": {
              "scoring_use": { "const": "informational_only" },
              "evidence_status": { "const": "not_numerically_established" }
            }
          }
        }
      ]
    },
    "phRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max", "evidence_status", "source_ids"],
      "properties": {
        "min": { "type": "number", "minimum": 3, "maximum": 10 },
        "max": { "type": "number", "minimum": 3, "maximum": 10 },
        "evidence_status": { "$ref": "#/$defs/evidenceStatus" },
        "source_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceId" } }
      }
    },
    "rootZoneDepth": {
      "type": "object",
      "description": "Core crop root-zone range used to select the SSURGO available-water integration depth.",
      "additionalProperties": false,
      "required": ["min", "max", "reference", "basis", "evidence_status", "source_ids"],
      "properties": {
        "min": { "type": "integer", "minimum": 1, "maximum": 500 },
        "max": { "type": "integer", "minimum": 1, "maximum": 500 },
        "reference": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 500,
          "description": "Optional single representative depth. Null is valid when the source supports a range but not one representative value."
        },
        "basis": { "type": "string", "minLength": 1 },
        "evidence_status": { "$ref": "#/$defs/evidenceStatus" },
        "source_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceId" } }
      }
    },
    "waterDemand": {
      "type": "object",
      "description": "The categorical class is core comparable MVP evidence. seasonal_range_mm is optional numeric context and may be null without invalidating the crop record.",
      "additionalProperties": false,
      "required": ["class", "seasonal_range_mm", "basis", "evidence_status", "source_ids"],
      "properties": {
        "class": { "type": "string", "enum": ["low", "moderate", "high", "very_high"] },
        "seasonal_range_mm": {
          "description": "Optional sourced seasonal crop-water range. Null is not zero demand and must not provide a ranking advantage.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["min", "max"],
              "properties": { "min": { "type": "number" }, "max": { "type": "number" } }
            }
          ]
        },
        "basis": { "type": "string", "minLength": 1 },
        "evidence_status": { "$ref": "#/$defs/evidenceStatus" },
        "source_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceId" } }
      }
    },
    "regionalSuitability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "rating", "basis"],
      "properties": {
        "region_id": { "$ref": "#/$defs/regionId" },
        "rating": { "type": "string", "enum": ["primary", "suitable", "conditional", "limited", "not_supported"] },
        "basis": { "type": "string", "minLength": 1 }
      }
    },
    "plantingWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "windows", "basis", "evidence_status", "source_ids"],
      "properties": {
        "region_id": { "$ref": "#/$defs/regionId" },
        "windows": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][a-z]{2}(-[A-Z][a-z]{2})?$" } },
        "basis": { "type": "string", "minLength": 1 },
        "evidence_status": { "$ref": "#/$defs/evidenceStatus" },
        "source_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceId" } }
      }
    },
    "crop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crop_id", "common_name", "scientific_name", "production_use", "variety_scope",
        "supported_texas_regions", "regional_suitability", "planting_windows_by_region", "days_to_maturity",
        "optimal_temperature_range", "heat_stress_threshold", "heat_exposure_duration", "heat_sensitive_stages",
        "frost_sensitivity", "temperature_unit", "temperature_measurement_basis",
        "preferred_soil_textures", "ph_tolerable_range", "effective_root_zone_depth_cm", "drainage_requirement",
        "water_demand", "drought_tolerance", "irrigation_requirement",
        "source_ids", "confidence", "last_reviewed", "assumptions", "catalog_version", "record_status"
      ],
      "properties": {
        "crop_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "common_name": { "type": "string", "minLength": 1 },
        "scientific_name": { "type": "string", "minLength": 1 },
        "production_use": { "type": "string", "minLength": 1 },
        "variety_scope": { "type": "string", "minLength": 1 },
        "supported_texas_regions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/regionId" } },
        "regional_suitability": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/regionalSuitability" } },
        "planting_windows_by_region": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/plantingWindow" } },
        "days_to_maturity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max", "basis", "evidence_status", "source_ids"],
          "properties": {
            "min": { "type": "integer", "minimum": 1 },
            "max": { "type": "integer", "minimum": 1 },
            "basis": { "type": "string", "minLength": 1 },
            "evidence_status": { "$ref": "#/$defs/evidenceStatus" },
            "source_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceId" } }
          }
        },
        "optimal_temperature_range": { "$ref": "#/$defs/temperatureRange" },
        "heat_stress_threshold": { "$ref": "#/$defs/heatThreshold" },
        "heat_exposure_duration": { "$ref": "#/$defs/heatDuration" },
        "heat_sensitive_stages": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Required explanatory evidence. It does not trigger stage-specific MVP scoring unless a separately validated crop-stage resolver is available."
        },
        "frost_sensitivity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "description", "source_ids"],
          "properties": {
            "class": { "type": "string", "enum": ["very_high", "high", "moderate", "low", "dormant_hardy"] },
            "description": { "type": "string", "minLength": 1 },
            "source_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceId" } }
          }
        },
        "temperature_unit": { "type": "string", "const": "degC" },
        "temperature_measurement_basis": { "type": "string", "minLength": 1 },
        "preferred_soil_textures": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "ph_tolerable_range": { "$ref": "#/$defs/phRange" },
        "effective_root_zone_depth_cm": { "$ref": "#/$defs/rootZoneDepth" },
        "drainage_requirement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "description", "source_ids"],
          "properties": {
            "class": { "type": "string", "enum": ["poorly_drained_tolerant", "moderate", "well_drained", "very_well_drained"] },
            "description": { "type": "string", "minLength": 1 },
            "source_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceId" } }
          }
        },
        "water_demand": { "$ref": "#/$defs/waterDemand" },
        "drought_tolerance": { "type": "string", "enum": ["very_low", "low", "moderate", "high", "very_high"] },
        "irrigation_requirement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "description", "source_ids"],
          "properties": {
            "class": { "type": "string", "enum": ["usually_required", "recommended", "conditional", "often_rainfed"] },
            "description": { "type": "string", "minLength": 1 },
            "source_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceId" } }
          }
        },
        "source_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceId" } },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "last_reviewed": { "type": "string", "format": "date" },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "catalog_version": { "type": "string", "const": "1.1.0" },
        "record_status": { "type": "string", "enum": ["provisional", "approved", "retired"] }
      }
    }
  }
}
