FROM node:22-bookworm-slim AS build

ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/package.json
RUN npm ci

COPY apps/web ./apps/web
COPY data/crop-catalog ./data/crop-catalog
COPY handoff/fatima_scoring_migrations ./handoff/fatima_scoring_migrations

ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL \
    NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=$NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY

RUN npm run web:build

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0

WORKDIR /app

RUN groupadd --system cropsage && useradd --system --gid cropsage cropsage

COPY --from=build --chown=cropsage:cropsage /app/package.json /app/package-lock.json ./
COPY --from=build --chown=cropsage:cropsage /app/node_modules ./node_modules
COPY --from=build --chown=cropsage:cropsage /app/apps/web/package.json ./apps/web/package.json
COPY --from=build --chown=cropsage:cropsage /app/apps/web/next.config.ts ./apps/web/next.config.ts
COPY --from=build --chown=cropsage:cropsage /app/apps/web/.next ./apps/web/.next

USER cropsage

EXPOSE 3000

CMD ["sh", "-c", "exec npm run start --workspace @cropsage/web -- --hostname 0.0.0.0 --port ${PORT:-3000}"]
