{
  "name": "cropsage",
  "version": "0.1.0",
  "private": true,
  "description": "CropSage application, database migrations, and local tooling",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:fixtures": "node scripts/generate-handoff-db-test.mjs",
    "db:test": "npm run db:fixtures && supabase test db",
    "db:lint": "supabase db lint --schema public --fail-on error",
    "benchmark:dry-run": "node scripts/import-benchmark-supabase.mjs --dry-run --report data/import/texas_15_sites_five_scenarios.import-plan.json",
    "benchmark:import": "node scripts/import-benchmark-supabase.mjs --execute --confirm texas_15_sites_five_scenarios --report data/import/texas_15_sites_five_scenarios.import-report.json",
    "benchmark:test": "node --test scripts/import-benchmark-supabase.test.mjs",
    "benchmark:verify": "node scripts/import-benchmark-supabase.mjs --verify-only --report data/import/texas_15_sites_five_scenarios.verification-report.json",
    "web:dev": "npm run dev --workspace @cropsage/web",
    "web:build": "npm run build --workspace @cropsage/web",
    "web:lint": "npm run lint --workspace @cropsage/web",
    "web:test": "npm run test --workspace @cropsage/web"
  },
  "devDependencies": {
    "railway": "^3.11.0",
    "supabase": "2.116.0"
  }
}
