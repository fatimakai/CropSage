# Railway injects PORT automatically.

# Language layer: OpenRouter is primary; Gemini is optional failover.
OPEN_ROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Required only when running live FortyGuard provider collection.
FORTYGUARD_API_KEY=
FORTYGUARD_BASE_URL=https://api.fortyguard.com

# Frozen contract and runtime settings.
EVIDENCE_BUNDLE_SCHEMA_VERSION=1.2.0
FARM_PROFILE_SCHEMA_VERSION=1.0.0
RECOMMENDATION_SCHEMA_VERSION=1.0.0
SCORING_ENGINE_VERSION=1.0.0
CROP_CATALOG_VERSION=1.1.0
MAX_REQUEST_BYTES=8388608
LOG_LEVEL=INFO
ENABLE_API_DOCS=false
