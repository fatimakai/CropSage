{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cropsage.local/schemas/recommendation.schema.json",
  "title": "CropSage deterministic recommendation output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scoring_version", "generated_at", "status", "evaluation_mode", "profile_id", "evidence_bundle_id", "location", "requested_crop_id", "requested_crop_result", "rankings", "limitations", "method"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "scoring_version": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "status": { "const": "validated" },
    "evaluation_mode": { "enum": ["planning", "planting_readiness"] },
    "profile_id": { "type": "string" },
    "evidence_bundle_id": { "type": "string" },
    "location": { "type": "object" },
    "requested_crop_id": { "type": ["string", "null"] },
    "requested_crop_result": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/cropResult" }] },
    "rankings": { "type": "array", "minItems": 22, "maxItems": 22, "items": { "$ref": "#/$defs/cropResult" } },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suitability", "confidence", "active_weight_percent"],
      "properties": {
        "suitability": { "type": "string" },
        "confidence": { "type": "string" },
        "active_weight_percent": { "const": 100.0 }
      }
    }
  },
  "$defs": {
    "factor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factor_id", "category", "weight_percent", "available", "score", "evidence_confidence", "weighted_points", "scoring_use", "reason", "evidence"],
      "properties": {
        "factor_id": { "type": "string" },
        "category": { "enum": ["thermal_heat", "soil", "water", "location_season"] },
        "weight_percent": { "type": "number", "minimum": 0 },
        "available": { "type": "boolean" },
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "evidence_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "weighted_points": { "type": ["number", "null"] },
        "scoring_use": { "enum": ["scored", "informational_only", "inactive"] },
        "reason": { "type": "string" },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sources", "values"],
          "properties": {
            "sources": { "type": "array", "items": { "type": "string" } },
            "values": { "type": "object" }
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "cap", "reason"],
      "properties": {
        "gate": { "type": "string" },
        "cap": { "type": "number", "minimum": 0, "maximum": 100 },
        "reason": { "type": "string" }
      }
    },
    "highlight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factor_id", "score", "reason"],
      "properties": {
        "factor_id": { "type": "string" },
        "score": { "type": "number" },
        "reason": { "type": "string" }
      }
    },
    "cropResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crop_id", "crop_name", "status", "suitability_score", "recommendation", "confidence_score", "confidence_band", "evidence_coverage_percent", "applied_caps", "factors", "key_strengths", "key_risks", "warnings", "rank"],
      "properties": {
        "crop_id": { "type": "string" },
        "crop_name": { "type": "string" },
        "status": { "enum": ["scored", "insufficient_evidence"] },
        "suitability_score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "recommendation": { "enum": ["recommended", "conditional", "not_recommended", "insufficient_evidence"] },
        "confidence_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "confidence_band": { "enum": ["high", "medium", "low"] },
        "evidence_coverage_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "applied_caps": { "type": "array", "items": { "$ref": "#/$defs/gate" } },
        "factors": { "type": "array", "minItems": 18, "maxItems": 18, "items": { "$ref": "#/$defs/factor" } },
        "key_strengths": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/highlight" } },
        "key_risks": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/highlight" } },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "rank": { "type": "integer", "minimum": 1, "maximum": 22 }
      }
    }
  }
}
